[Unit]
Description=Janjez.social Next.js Application
Documentation=https://nextjs.org
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/janjez-socio
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/npm start
ExecReload=/bin/kill -SIGUSR1 $MAINPID
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=janjez-socio
User=ec2-user
Group=ec2-user

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/janjez-socio /var/log/janjez-socio /tmp

[Install]
WantedBy=multi-user.target
