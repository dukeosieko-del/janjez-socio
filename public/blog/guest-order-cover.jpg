<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="630" viewBox="0 0 1200 630">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0D0D0D"/>
      <stop offset="100%" stop-color="#1a1a1a"/>
    </linearGradient>
    <linearGradient id="accent" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#00A859"/>
      <stop offset="100%" stop-color="#00A859" stop-opacity="0.6"/>
    </linearGradient>
  </defs>
  <rect width="1200" height="630" fill="url(#bg)"/>
  <rect x="60" y="60" width="1080" height="510" rx="24" fill="none" stroke="url(#accent)" stroke-width="2"/>
  <text x="600" y="280" font-family="system-ui, -apple-system, sans-serif" font-size="48" font-weight="700" fill="#FFFFFF" text-anchor="middle">
    You Don't Need to Log In
  </text>
  <text x="600" y="340" font-family="system-ui, -apple-system, sans-serif" font-size="24" fill="#00A859" text-anchor="middle">
    All Prices on Services You Will Ever Imagine Are Here
  </text>
  <text x="600" y="420" font-family="system-ui, -apple-system, sans-serif" font-size="18" fill="rgba(255,255,255,0.6)" text-anchor="middle">
    Guest checkout in 60 seconds via M-Pesa
  </text>
  <circle cx="600" cy="520" r="30" fill="#00A859" opacity="0.2"/>
  <text x="600" y="530" font-family="system-ui, -apple-system, sans-serif" font-size="20" fill="#00A859" text-anchor="middle">🛒</text>
</svg>