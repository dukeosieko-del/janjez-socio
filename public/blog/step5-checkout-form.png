  <text x="240" y="440" font-family="system-ui, -apple-system, sans-serif" font-size="14" fill="rgba(255,255,255,0.5)">Quantity</text>
  <rect x="240" y="450" width="200" height="44" rx="8" fill="rgba(255,255,255,0.05)" stroke="rgba(255,255,255,0.1)"/>
  <text x="260" y="478" font-family="system-ui, -apple-system, sans-serif" font-size="13" fill="rgba(255,255,255,0.3)">1000</text>
  <rect x="240" y="520" width="24" height="24" rx="6" fill="#00A859" opacity="0.3"/>
  <text x="240" y="565" font-family="system-ui, -apple-system, sans-serif" font-size="13" fill="rgba(255,255,255,0.5)">Place order as guest (no account needed)</text>
