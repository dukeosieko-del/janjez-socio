<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="630" viewBox="0 0 1200 630">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0D0D0D"/>
      <stop offset="100%" stop-color="#1a1a1a"/>
    </linearGradient>
  </defs>
  <rect width="1200" height="630" fill="url(#bg)"/>
  <rect x="60" y="60" width="1080" height="510" rx="24" fill="rgba(255,255,255,0.03)" stroke="rgba(255,255,255,0.1)" stroke-width="1"/>
  <text x="600" y="280" font-family="system-ui, -apple-system, sans-serif" font-size="36" font-weight="600" fill="#FFFFFF" text-anchor="middle">
    Step 1: Open the Service Catalog
  </text>
  <text x="600" y="330" font-family="system-ui, -apple-system, sans-serif" font-size="18" fill="rgba(255,255,255,0.6)" text-anchor="middle">
    Click [🛒 New Order] in the top navigation bar
  </text>
  <rect x="400" y="380" width="400" height="60" rx="12" fill="#00A859" opacity="0.15"/>
  <text x="600" y="418" font-family="system-ui, -apple-system, sans-serif" font-size="16" fill="#00A859" text-anchor="middle">🛒 New Order</text>
</svg>