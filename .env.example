# Brevo SMTP (Transactional Email) Configuration
# Get the SMTP login + SMTP key from https://app.brevo.com/settings/keys/smtp
# Verify the sender domain/address at https://app.brevo.com/settings/senders
# BREVO_SMTP_USER is the SMTP login (NOT your Brevo account email)
# BREVO_SMTP_KEY is the SMTP relay key (NOT the Brevo API key)
# BREVO_FROM_EMAIL must be a verified sender; the SMTP login is only an auth credential
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=

# M-Pesa Configuration
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_ENV=production

# SMM Provider Configuration
SMM_API_URL=https://dripfeedpanel.com/api/v2
SMM_API_KEY=
SMM_FULFILLMENT_ENABLED=true

# Optional: Analytics
NEXT_PUBLIC_GA_ID=

# Cron job secret for SMM sync endpoint
CRON_SECRET=

# Deployment URL for cron job (required for GitHub Actions scheduled sync)
DEPLOY_URL=https://janjez.social
